{
  "name": "edgar-filings-api",
  "version": "0.1.0",
  "description": "Read-only REST API over SEC EDGAR filings for six companies",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "jest test/unit",
    "test:e2e": "jest test/e2e",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src test"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.6.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "nestjs-pino": "5.3.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  }
}
