{
  "info": {
    "_postman_id": "140b3430-9336-5467-8a1c-75447b684fe8",
    "name": "EDGAR Filings API",
    "description": "Checks the running API against docs/specs/2026-11-20-filings-api-core.md (§7, §8, §11.2). Run against a ready service with live SEC data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Spec §8: every error is application/problem+json with the five fields.",
          "const code = pm.response.code;",
          "if (code >= 400) {",
          "  pm.test(`[${code}] error is problem+json with type, title, status, detail, instance`, () => {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
          "    const p = pm.response.json();",
          "    ['type', 'title', 'detail', 'instance'].forEach((k) => pm.expect(p[k], k).to.be.a('string'));",
          "    pm.expect(p.status).to.equal(code);",
          "    pm.expect(p.type).to.match(/^\\/problems\\/[a-z-]+$/);",
          "  });",
          "  if (code === 503) {",
          "    pm.test('503 carries Retry-After', () => pm.expect(pm.response.headers.get('Retry-After')).to.match(/^\\d+$/));",
          "  }",
          "}"
        ]
      }
    }
  ],
