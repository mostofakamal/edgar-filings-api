          "name": "cursor walk page 1",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('walkSeen', '[]');",
                  "pm.collectionVariables.set('walkLastKey', 'null');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const keyOf = (f) => [f.filingDate, f.acceptanceDateTime, f.accessionNumber];",
                  "const newerOrEqual = (a, b) => {",
                  "  for (let i = 0; i < 3; i++) { if (a[i] !== b[i]) return a[i] > b[i]; }",
                  "  return true;",
                  "};",
                  "",
                  "const body = pm.response.json();",
                  "const seen = JSON.parse(pm.collectionVariables.get('walkSeen') || '[]');",
                  "const lastKey = JSON.parse(pm.collectionVariables.get('walkLastKey') || 'null');",
                  "pm.test('200 with 5 rows and a next cursor', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(body.data.length).to.equal(5);",
                  "  pm.expect(body.page.nextCursor).to.be.a('string');",
                  "});",
                  "pm.test('no accession repeats across pages', () => {",
                  "  body.data.forEach((f) => pm.expect(seen, f.accessionNumber).to.not.include(f.accessionNumber));",
                  "});",
                  "pm.test('order continues from the previous page', () => {",
                  "  if (lastKey) pm.expect(newerOrEqual(lastKey, keyOf(body.data[0]))).to.equal(true);",
                  "});",
                  "pm.collectionVariables.set('walkSeen', JSON.stringify(seen.concat(body.data.map((f) => f.accessionNumber))));",
                  "pm.collectionVariables.set('walkLastKey', JSON.stringify(keyOf(body.data[body.data.length - 1])));",
                  "pm.collectionVariables.set('walkCursor', body.page.nextCursor || '');",
                  "pm.collectionVariables.set('firstPageCursor', body.page.nextCursor || '');"
                ]
              }
            }
