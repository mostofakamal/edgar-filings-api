                  "  pm.expect(pm.response.json().status).to.equal('ready');",
                  "});",
                  "pm.test('lists all six companies with a known status', () => {",
                  "  const companies = pm.response.json().companies;",
                  "  pm.expect(Object.keys(companies).sort()).to.eql(['AAPL', 'AMZN', 'GOOGL', 'GS', 'META', 'NFLX']);",
                  "  Object.values(companies).forEach((c) => pm.expect(['not_loaded', 'failed', 'loaded', 'stale']).to.include(c.status));",
                  "});"
                ]
              }
